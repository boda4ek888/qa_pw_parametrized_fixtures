{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["@playwright/test"]
  },
  "include": [
    "playwright.config.js",
    "src/**/*.js",
    "tests/**/*.ts",
    "tests/**/*.js"
  ]
}

